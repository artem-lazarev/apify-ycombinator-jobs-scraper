  "fields": {
    "company": {
      "type": "object",
      "title": "Company",
      "description": "Company information from Y Combinator",
      "properties": {
        "id": {
          "type": "integer",
          "title": "Company ID",
          "description": "Unique identifier for the company"
        },
        "name": {
          "type": "string",
          "title": "Company Name",
          "description": "Name of the company"
        },
        "slug": {
          "type": "string",
          "title": "URL Slug",
          "description": "URL-friendly identifier for the company"
        },
        "formerNames": {
          "type": "array",
          "title": "Former Names",
          "description": "Previous names of the company"
        },
        "tagline": {
          "type": "string",
          "title": "Tagline",
          "description": "Company one-liner/tagline"
        },
        "longDescription": {
          "type": "string",
          "title": "Description",
          "description": "Detailed description of the company"
        },
        "website": {
          "type": "string",
          "title": "Website",
          "description": "Company website URL"
        },
        "logoUrl": {
          "type": "string",
          "title": "Logo URL",
          "description": "URL to the company logo"
        },
        "ycUrl": {
          "type": "string",
          "title": "YC Profile URL",
          "description": "Y Combinator profile page URL"
        },
        "ycBatch": {
          "type": "string",
          "title": "YC Batch",
          "description": "Y Combinator batch (e.g., W24, S23)"
        },
        "foundedYear": {
          "type": "integer",
          "title": "Founded Year",
          "description": "Year the company was founded"
        },
        "teamSize": {
          "type": "integer",
          "title": "Team Size",
          "description": "Number of employees"
        },
        "status": {
          "type": "string",
          "title": "Status",
          "description": "Company status (Active, Acquired, etc.)"
        },
        "stage": {
          "type": "string",
          "title": "Stage",
          "description": "Funding stage (Seed, Series A, etc.)"
        },
        "industry": {
          "type": "string",
          "title": "Industry",
          "description": "Primary industry"
        },
        "subindustry": {
          "type": "string",
          "title": "Sub-Industry",
          "description": "Sub-industry classification"
        },
        "industries": {
          "type": "array",
          "title": "Industries",
          "description": "List of industries"
        },
        "tags": {
          "type": "array",
          "title": "Tags",
          "description": "Company tags/categories"
        },
        "topCompany": {
          "type": "boolean",
          "title": "Top Company",
          "description": "Whether this is a top YC company"
        },
        "allLocations": {
          "type": "string",
          "title": "All Locations",
          "description": "Company locations as text"
        },
        "regions": {
          "type": "array",
          "title": "Regions",
          "description": "Geographic regions"
        },
        "socialLinks": {
          "type": "object",
          "title": "Social Links",
          "description": "Links to social media profiles (LinkedIn, Twitter, GitHub, etc.)"
        }
      }
    },
    "founders": {
      "type": "array",
      "title": "Founders",
      "description": "List of company founders",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Founder's name"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Founder's role/title"
          },
          "description": {
            "type": "string",
            "title": "Bio",
            "description": "Founder's biography"
          },
          "linkedin": {
            "type": "string",
            "title": "LinkedIn",
            "description": "LinkedIn profile URL"
          },
          "twitter": {
            "type": "string",
            "title": "Twitter",
            "description": "Twitter/X profile URL"
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "title": "Jobs",
      "description": "List of open job positions",
      "items": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Job ID",
            "description": "Unique identifier for the job"
          },
          "title": {
            "type": "string",
            "title": "Job Title",
            "description": "Title of the job position"
          },
          "jobUrl": {
            "type": "string",
            "title": "Job URL",
            "description": "URL to the job posting"
          },
          "location": {
            "type": "string",
            "title": "Location",
            "description": "Job location (Remote, City, etc.)"
          },
          "salary": {
            "type": "object",
            "title": "Salary",
            "description": "Salary range with min, max, currency, and period"
          },
          "equity": {
            "type": "object",
            "title": "Equity",
            "description": "Equity range with min and max percentages"
          },
          "jobType": {
            "type": "string",
            "title": "Job Type",
            "description": "Type of employment (Full-time, Part-time, Contract)"
          },
          "roleCategory": {
            "type": "string",
            "title": "Role Category",
            "description": "Category of the role (Engineering, Design, etc.)"
          },
          "experience": {
            "type": "string",
            "title": "Experience",
            "description": "Required experience level"
          },
          "visa": {
            "type": "string",
            "title": "Visa Sponsorship",
            "description": "Visa sponsorship availability"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Full job description"
          },
          "interviewProcess": {
            "type": "string",
            "title": "Interview Process",
            "description": "Description of the interview process"
          }
        }
      }
    },
    "scrapedAt": {
      "type": "string",
      "title": "Scraped At",
      "description": "Timestamp when the data was scraped",
      "format": "date-time"
    }
  }
